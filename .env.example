# Optional NVD API key for ForgeJS collection.
NVD_API_KEY=

# OpenAI-compatible endpoints used by JudgeJS.
# Update these URLs if you evaluate through an institutional proxy or a
# provider-specific OpenAI-compatible gateway.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=

ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=

# RQ1 runtime defaults.
# The paper configuration uses temperature 0.7.
SECJS_TEMPERATURE=0.7
SECJS_LLM_TIMEOUT=60
SECJS_MAX_RETRIES=3
SECJS_MAX_TOKENS=4096
